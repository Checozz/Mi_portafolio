---
import "../styles/global.css";
import Navbar from "../components/commons/navbar/navbar.astro";
import Footer from "../components/commons/footer/footer.astro";
import { getLang, useTranslations } from "../i18n/utils.js";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={t("siteDescription")} />
    <title>{t("siteTitle")}</title>
  </head>
  <body class="bg-gray-950 text-white">
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>
