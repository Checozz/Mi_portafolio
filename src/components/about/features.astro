---
import ServiceCard from "./ServiceCard.astro";
import { FaBrain, FaServer, FaScrewdriverWrench } from "react-icons/fa6";
import { getLang, useTranslations } from "../../i18n/utils.js";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="site-container mt-14 mx-auto max-w-6xl px-4">
  <h2
    class="text-4xl font-bold flex flex-col items-center gap-6 text-center whitespace-nowrap text-white md:flex-row md:items-center md:text-end"
  >
    <span class="hidden h-1.5 grow rounded-lg drop-shadow-[2px_2px_0_#0debd8] bg-[#7836cf] md:block"></span>
    <span class="drop-shadow-[2px_2px_0_#7836cf]">{t("features_title")}</span>
  </h2>

  <div class="mt-10 grid gap-6 md:grid-cols-3">
    <ServiceCard
      icon={FaBrain}
      title={t("feature1_title")}
      description={t("feature1_desc")}
    />
    <ServiceCard
      icon={FaServer}
      title={t("feature2_title")}
      description={t("feature2_desc")}
    />
    <ServiceCard
      icon={FaScrewdriverWrench}
      title={t("feature3_title")}
      description={t("feature3_desc")}
    />
  </div>
</section>
