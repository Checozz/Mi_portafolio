---
import MiFoto from "../../assets/img/MiFoto.png";
import { getLang, useTranslations } from "../../i18n/utils.js";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<div
  class="mx-auto mt-20 flex max-w-6xl flex-col items-center gap-8 px-6 lg:flex-row"
>
  <!-- Imagen -->
  <div
    class="border-primary h-64 w-64 overflow-hidden rounded-2xl shadow-lg md:h-96 md:w-96 drop-shadow-[4px_4px_0_#7836cf]"
  >
    <img
      src={MiFoto.src}
      alt="Foto de Sergio"
      class="h-full w-full object-cover"
    />
  </div>

  <!-- Texto -->
  <div class="flex-1 text-center text-gray-300 lg:text-left">
    <h2 class="text-3xl font-bold text-white">
      {t("about_name")} <span class="text-white text-shadow">Hernández Vera</span>
    </h2>
    <p class="mt-4">
      {t("about_bio1")}
    </p>
    <p class="mt-2">
      {t("about_bio2")}
    </p>
    <p class="mt-2">
      {t("about_bio3")}
    </p>
  </div>
</div>
