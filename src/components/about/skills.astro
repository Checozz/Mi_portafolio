---
import { getLang, useTranslations } from "../../i18n/utils.js";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const skills = [
  { name: "Python", icon: "python", path: "python/python-original" },
  { name: "JavaScript", icon: "javascript", path: "javascript/javascript-original" },
  { name: "TypeScript", icon: "typescript", path: "typescript/typescript-original" },
  { name: "Golang", icon: "go", path: "go/go-original" },
  { name: "Kotlin", icon: "kotlin", path: "kotlin/kotlin-original" },
  { name: "Java", icon: "java", path: "java/java-original" },
  { name: "TensorFlow", icon: "tensorflow", path: "tensorflow/tensorflow-original" },
  { name: "Docker", icon: "docker", path: "docker/docker-original" },
  { name: "Git", icon: "git", path: "git/git-original" },
  { name: "Firebase", icon: "firebase", path: "firebase/firebase-plain" },
  { name: "MongoDB", icon: "mongodb", path: "mongodb/mongodb-original" },
  { name: "MySQL", icon: "mysql", path: "mysql/mysql-original" },
  { name: "HTML", icon: "html5", path: "html5/html5-original" },
  { name: "CSS", icon: "css3", path: "css3/css3-original" },
  { name: "React", icon: "react", path: "react/react-original" },
  { name: "Astro", icon: "astro", path: "astro/astro-original" },
];
---

<section class="site-container mt-14 mx-auto max-w-6xl px-4">
  <div class="site-container mt-14">
    <h2
      class="text-4xl font-bold flex flex-col items-center gap-6 text-center whitespace-nowrap text-white md:flex-row md:items-center md:text-start"
    >
      <span class="drop-shadow-[2px_2px_0_#7836cf]">{t("skills_title")}</span>
      <span
        class="hidden h-1.5 grow rounded-lg drop-shadow-[2px_2px_0_#0debd8] bg-[#7836cf] md:block"
      ></span>
    </h2>
  </div>
  <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
    {
      skills.map((skill) => (
        <div class="relative group">
          <div class="absolute inset-0 -z-10 rounded-lg blur-3xl opacity-0 transition-opacity group-hover:opacity-100" />
          <div class="flex flex-col items-center bg-gray-900 p-4 drop-shadow-[4px_4px_0_#7836cf] rounded-lg shadow-md transition-transform hover:scale-105">
            <img
              src={`https://cdn.jsdelivr.net/gh/devicons/devicon/icons/${skill.path}.svg`}
              alt={skill.name}
              class="w-12 h-12"
              onerror="this.src='/svg/git.svg'"
            />
            <p class="mt-2 text-white text-lg font-semibold drop-shadow-[1px_1px_0_#7836cf]">{skill.name}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
