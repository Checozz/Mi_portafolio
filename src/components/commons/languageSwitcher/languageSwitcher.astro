---
import { getLang, getAlternatePath } from "../../../i18n/utils.js";

const lang = getLang(Astro.currentLocale);
const otherLang = lang === "es" ? "en" : "es";
const alternatePath = getAlternatePath(Astro.url.pathname, lang);
---

<a
  href={alternatePath}
  class="flex items-center gap-1 px-3 py-1 rounded-full border border-white/20 text-sm font-bold text-white hover:border-[#69c7c7] hover:text-[#69c7c7] transition-all duration-200"
  aria-label={`Switch to ${otherLang === "en" ? "English" : "Español"}`}
  title={otherLang === "en" ? "Switch to English" : "Cambiar a Español"}
>
  {otherLang === "en" ? "EN" : "ES"}
</a>
