---
import SocialIcons from "../socialIcons/socialIcons.jsx";
import { getLang, useTranslations } from "../../../i18n/utils.js";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const prefix = lang === "en" ? "/en" : "";
---

<footer class="bg-gray-950 text-white">
  <div
    class="container mx-auto flex flex-col items-center justify-between px-6 py-12 lg:flex-row lg:px-20"
  >
    <!-- Logo -->
    <a href={`${prefix}/`} class="flex items-center">
      <h3
        class="text-[#69c7c7] text-4xl font-bold drop-shadow-[1.5px_1.5px_0_#7836cf]"
      >
        SAH
      </h3>
    </a>

    <!-- Navigation Links -->
    <nav class="mb-4 lg:mb-0">
      <ul
        class="flex flex-col items-center space-y-2 text-gray-400 lg:flex-row lg:items-start lg:space-y-0 lg:space-x-6"
      >
        <li>
          <a href={`${prefix}/`} class="hover:text-[#552496] font-semibold">{t("nav_home")}</a>
        </li>
        <li>
          <a href={`${prefix}/proyectos`} class="hover:text-[#552496] font-semibold">{t("nav_projects")}</a>
        </li>
        <li>
          <a href={`${prefix}/about`} class="hover:text-[#552496] font-semibold">{t("nav_about")}</a>
        </li>
        <li>
          <a href={`${prefix}/contact`} class="hover:text-[#552496] font-semibold">{t("nav_contact")}</a>
        </li>
      </ul>
    </nav>

    <!-- Social Media Links -->
    <div class="flex space-x-4">
      <SocialIcons client:visible />
    </div>
  </div>

  <!-- Copyright -->
  <div
    class="w-full border-t border-gray-600 py-10 text-center text-sm text-gray-500"
  >
    {t("footer_email")}
  </div>
</footer>
